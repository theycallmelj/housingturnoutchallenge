# Copy to agents/.env (gitignored) and fill in. Load with: set -a; source agents/.env; set +a
# Never commit a real key.

# Hosted on OpenRouter (recommended): gpt-oss-120b leader, gpt-oss-20b experts
HOUSING_LLM_HOST=openrouter
OPENROUTER_API_KEY=

# Optional overrides (registry ids from agents/model-registry.json)
# HOUSING_MODEL_PROFILE=openrouter
# HOUSING_LEADER_MODEL=gpt-oss-120b
# HOUSING_EXPERT_MODEL=gpt-oss-20b
# HOUSING_EXPERT_MODEL_ADU=qwen3-14b

# Self-hosted instead (Ollama):
# HOUSING_LLM_HOST=ollama
# HOUSING_LLM_BASE_URL=http://localhost:11434/v1
